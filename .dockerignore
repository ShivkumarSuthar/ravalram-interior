# Ignore dependency directories
node_modules/
jspm_packages/
web_modules/

# Ignore build outputs
dist/
build/
out/
.next/
.serverless/

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Ignore environment/secret files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example
*.pem
*.key

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE configs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ignore docker files from copying themselves unneededly
Dockerfile
docker-compose.yml
nginx.conf
.dockerignore
.git
.gitignore
README.md
AGENTS.md
